    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Cómo leerlo",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Castigar un crédito lo saca del balance, y con él de la morosidad. Sumar los castigos de los últimos 12 meses muestra el deterioro que el indicador tradicional ya no ve.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "La brecha se duplicó · ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0b0b0b"
                    }
                  },
                  {
                    "value": "de 1,48 pp en 2019 a 2,92 pp en noviembre de 2024, cuando los bancos castigaron S/ 11 000 millones en 12 meses (2,5 veces lo de 2019).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "La recuperación es real · ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0b0b0b"
                    }
                  },
                  {
                    "value": "entre mayo de 2024 y julio de 2026 la morosidad ajustada cae 2,62 pp, más que la tradicional (1,64 pp).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "La serie ajustada empieza en diciembre de 2016: en 2015 la SBS publicaba los castigos por trimestre.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#8a8984"
                    }
                  }
                ]
              }
            ]
          }
        }
